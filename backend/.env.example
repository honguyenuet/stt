PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=
TRUST_PROXY_HOPS=1
GLOBAL_API_RATE_WINDOW_SECONDS=900
GLOBAL_API_RATE_LIMIT=5000
# Quan sát vận hành và cảnh báo.
OBS_HTTP_5XX_ALERT_THRESHOLD=5
OBS_FAILED_JOB_ALERT_THRESHOLD=3
OBSERVABILITY_LOG_RETENTION_DAYS=30
OBSERVABILITY_ALERT_EMAILS=
LOG_OBSERVABILITY_ERRORS=false

# Production: tạo các khóa ngẫu nhiên khác nhau, mỗi khóa tối thiểu 32 byte.
JWT_SECRET=
AUDIT_HASH_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
JWT_ISSUER=vbee-aivoice
JWT_AUDIENCE=vbee-web
SECURITY_AUDIT_RETENTION_DAYS=180
ADMIN_AUDIT_RETENTION_DAYS=365
# URL HTTPS công khai của backend, dùng để Sonix tải file lớn qua file_url.
PUBLIC_BACKEND_URL=
PROVIDER_FILE_SIGNING_SECRET=
PROVIDER_FILE_URL_TTL_SECONDS=7200
# Nếu để trống, chữ ký phát audio dùng JWT_SECRET. Production nên dùng khóa riêng.
AUDIO_URL_SECRET=
AUDIO_STREAM_TTL_SECONDS=300
# Muối riêng để băm địa chỉ IP trong request log, không dùng lại JWT_SECRET ở production.
REQUEST_LOG_IP_SALT=

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=golden_voice
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_SSL_CA=
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=30000

# Google OAuth 2.0 - không bắt buộc nếu dùng email/password login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# Facebook Login - tạo app tại developers.facebook.com.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_API_VERSION=v23.0
FACEBOOK_CALLBACK_URL=http://localhost:3001/api/auth/facebook/callback

# Sign in with Apple yêu cầu HTTPS và domain thật, không hỗ trợ localhost.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
# Có thể dùng APPLE_PRIVATE_KEY với \n thay cho file .p8. Không commit khóa này.
APPLE_PRIVATE_KEY=
APPLE_CALLBACK_URL=https://your-domain.example/api/auth/apple/callback
OAUTH_STATE_TTL_MINUTES=10

# SMTP gửi email quên mật khẩu và cảnh báo quota cho quản trị viên.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Vbee AIVoice <no-reply@vbee.local>
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_VERIFICATION_REQUIRED=true
EMAIL_VERIFICATION_TTL_HOURS=24
LOGIN_ALERT_EMAIL_ENABLED=true
QUOTA_ALERT_EMAIL_ENABLED=true
QUOTA_ALERT_EMAIL_INTERVAL_SECONDS=30
QUOTA_ALERT_EMAIL_MAX_ATTEMPTS=5
QUOTA_ALERT_ADMIN_EMAILS=
QUOTA_ALERT_RECONCILE_INTERVAL_MINUTES=15
QUOTA_ALERT_RECONCILE_USER_LIMIT=5000

# Nguồn API key khi provider mặc định được chọn từ CMS:
# cms = ưu tiên key CMS rồi fallback .env; env = chỉ dùng .env;
# env_fallback_cms = ưu tiên .env; cms_fallback_env = ưu tiên CMS.
PROVIDER_KEY_SOURCE=cms
# Provider: auto, vbee, sonix, deepgram hoặc assemblyai.
# auto ưu tiên nhà cung cấp đầu tiên trong chain đã có đủ khóa xác thực.
TRANSCRIPTION_PROVIDER=auto
PROVIDER_FAILOVER_ENABLED=true
TRANSCRIPTION_PROVIDER_CHAIN=vbee,assemblyai,deepgram,sonix
PROVIDER_RETRY_ATTEMPTS=2
PROVIDER_RETRY_BASE_MS=750
PROVIDER_CIRCUIT_BREAKER_ENABLED=true
PROVIDER_CIRCUIT_FAILURE_THRESHOLD=3
PROVIDER_CIRCUIT_OPEN_SECONDS=120
PROVIDER_CIRCUIT_MAX_OPEN_SECONDS=1800
PROVIDER_CIRCUIT_PROBE_SECONDS=90
MAX_UPLOAD_MB=102400
SYNC_API_MAX_MB=25
ALLOW_SYNC_PUBLIC_API=false
UPLOAD_STAGING_DIR=
MALWARE_SCAN_REQUIRED=false
CLAMAV_SCAN_COMMAND=
CLAMAV_DATABASE_DIR=
CLAMAV_SCAN_MODE=clamscan
CLAMAV_SCAN_CONFIG=
MALWARE_SCAN_TIMEOUT_MS=120000
# Production multiple-server setup: mount the same persistent volume on every API/worker node.
UPLOADS_DIR=

# Persistent PostgreSQL job queue. Upload returns immediately; this worker processes jobs in the background.
# Local can run both in one process. Production API: false; dedicated `npm run worker`: true.
RUN_TRANSCRIPTION_WORKER=true
TRANSCRIPTION_QUEUE_CONCURRENCY=2
TRANSCRIPTION_QUEUE_POLL_MS=1000
TRANSCRIPTION_QUEUE_STALE_SECONDS=1200
TRANSCRIPTION_QUEUE_HEARTBEAT_MS=60000
TRANSCRIPTION_QUEUE_MAX_ATTEMPTS=3
TRANSCRIPTION_QUEUE_RETRY_BASE_SECONDS=15
TRANSCRIPTION_QUEUE_RETRY_MAX_SECONDS=300
TRANSCRIPTION_JOB_TIMEOUT_SECONDS=3600
TRANSCRIPTION_QUEUE_RETENTION_MS=3600000
MULTITRACK_MIX_TIMEOUT_MS=1200000
FREE_AUDIO_RETENTION_DAYS=30
STANDARD_AUDIO_RETENTION_DAYS=180
SPECIAL_AUDIO_RETENTION_DAYS=36500
BUSINESS_AUDIO_RETENTION_DAYS=36500
MAX_PENDING_JOBS_PER_USER=5
MAX_PENDING_JOBS_GLOBAL=500

# Optional vocal isolation for Upload mode "Bài hát / nhạc nền".
AUDIO_PREPROCESSING_ENABLED=true
AUDIO_PREPROCESSING_TIMEOUT_MS=180000
FFMPEG_PATH=
# Nhập media từ URL. Production phải đi qua egress proxy có lọc SSRF.
MEDIA_URL_IMPORT_ENABLED=true
MEDIA_IMPORT_HOSTS=
MEDIA_IMPORT_EGRESS_PROXY_URL=
YOUTUBE_IMPORT_ENABLED=true
YT_DLP_PATH=
# File cookies.txt của tài khoản dịch vụ được phép truy cập video. Không dùng cookies trình duyệt cá nhân trên server.
YOUTUBE_COOKIES_FILE=
YOUTUBE_FALLBACK_PLAYER_CLIENTS=android_vr,web_embedded
YOUTUBE_METADATA_TIMEOUT_MS=45000
YOUTUBE_DOWNLOAD_TIMEOUT_MS=600000
# auto = try Python Demucs; if it fails, keep the original audio unchanged.
DEMUCS_ENABLED=auto
DEMUCS_PYTHON_PATH=python
DEMUCS_COMMAND=
DEMUCS_MODEL=htdemucs
DEMUCS_TIMEOUT_MS=600000
MIN_TRANSCRIPT_CONFIDENCE=0.9
SONG_MIN_TRANSCRIPT_CONFIDENCE=0.7
SONG_MIN_WORDS_PER_MINUTE=18
SONG_LOW_CONFIDENCE_THRESHOLD=0.65
SONG_MAX_LOW_CONFIDENCE_RATIO=0.3
SONG_MIN_TIMELINE_COVERAGE=0.7
SONG_MAX_TIMESTAMP_OVERRUN_SECONDS=3
SONG_MAX_WORD_DURATION_SECONDS=8
SONG_VOCAL_FILTER=anull

# Plan / quota controls
FREE_PLAN_SECONDS=1800
FREE_MAX_UPLOAD_MB=100
FREE_MAX_RECORD_SECONDS=600
FREE_MAX_FILE_SECONDS=1800
REFERRAL_REWARD_SECONDS=6000
REFERRAL_REWARD_VALID_DAYS=90
REFERRAL_CLAIM_WINDOW_MINUTES=30
STANDARD_MONTHLY_SECONDS=18000
STANDARD_YEARLY_SECONDS=216000
STANDARD_MAX_UPLOAD_MB=300
STANDARD_MAX_RECORD_SECONDS=10800
STANDARD_MAX_FILE_SECONDS=10800
SPECIAL_MONTHLY_SECONDS=72000
SPECIAL_YEARLY_SECONDS=864000
SPECIAL_MAX_UPLOAD_MB=1024
SPECIAL_MAX_RECORD_SECONDS=14400
SPECIAL_MAX_FILE_SECONDS=14400
BUSINESS_MONTHLY_SECONDS=144000
BUSINESS_YEARLY_SECONDS=1728000
BUSINESS_MAX_UPLOAD_MB=2048
BUSINESS_MAX_RECORD_SECONDS=36000
BUSINESS_MAX_FILE_SECONDS=36000
DEFAULT_QUOTA_ALERT_SECONDS=300
WORKSPACE_INVITE_EXPIRES_DAYS=14

# Billing / checkout controls
BILLING_ORDER_TTL_MINUTES=30
BILLING_RECONCILE_INTERVAL_MS=60000
BILLING_RECONCILE_BATCH_SIZE=25
STANDARD_MONTHLY_PRICE_VND=149000
STANDARD_YEARLY_PRICE_VND=1490000
SPECIAL_MONTHLY_PRICE_VND=499000
SPECIAL_YEARLY_PRICE_VND=4990000
BUSINESS_MONTHLY_PRICE_VND=799000
BUSINESS_YEARLY_PRICE_VND=7990000
TOPUP_1H_PRICE_VND=39000
TOPUP_3H_PRICE_VND=117000
TOPUP_5H_PRICE_VND=195000
TOPUP_10H_PRICE_VND=390000
TOPUP_20H_PRICE_VND=780000
TOPUP_50H_PRICE_VND=1950000
TOPUP_100H_PRICE_VND=3900000
# PayOS (by Casso): create a channel at my.payos.vn, then configure its public webhook URL.
PAYMENT_PROVIDER=payos
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_API_BASE_URL=https://api-merchant.payos.vn
PAYOS_STATUS_CHECK_INTERVAL_SECONDS=8
PAYOS_REQUEST_TIMEOUT_MS=15000
# Example: https://api.your-domain.vn/api/billing/payos/webhook
PAYOS_WEBHOOK_URL=
# Webhook gửi kết quả cho khách hàng dùng Public API.
CUSTOMER_WEBHOOK_TIMEOUT_MS=8000
CUSTOMER_WEBHOOK_RETRY_ATTEMPTS=2
# Keep false in production. Demo activation never verifies a bank transfer.
ENABLE_DEMO_PAYMENTS=false
# Chỉ bật khi cần endpoint demo cũ POST /api/quota/upgrade, production nên để false.
ENABLE_DEV_QUOTA_UPGRADE=false
CREATE_DEMO_USER=false

# CMS / quản trị. Tài khoản phải đăng ký trước; backend chỉ cấp quyền cho email khớp.
# Phân tách nhiều email bằng dấu phẩy. Không dùng tài khoản mặc định hoặc mật khẩu chung.
ADMIN_EMAILS=
SUPER_ADMIN_EMAILS=
# Tùy chọn tạo Super Admin cho CMS V1. Phải điền cả hai; mật khẩu tối thiểu 12 ký tự.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_FIRST_NAME=Vbee
ADMIN_SEED_LAST_NAME=Admin
ADMIN_SEED_SYNC_PASSWORD=false
# Khóa mã hóa API key lưu trong CMS. Production phải dùng chuỗi ngẫu nhiên riêng.
PROVIDER_SECRET_KEY=

# Vbee STT API - dùng khi TRANSCRIPTION_PROVIDER=vbee.
# Có thể thay endpoint/path/field theo tài liệu Vbee hoặc cấu hình trong Admin CMS.
VBEE_API_KEY=your_vbee_stt_api_key_here
VBEE_API_KEY_HEADER=Authorization
VBEE_API_KEY_SCHEME=Bearer
# Tên cũ của API key vẫn được hỗ trợ để tương thích cấu hình đã triển khai.
AIMP_API_KEY=
VBEE_API_BASE_URL=https://api-voice-uat.vbeelabs.ai
# Cặp thông tin cũ bên dưới chỉ cần khi không dùng VBEE_API_KEY.
VBEE_STT_TOKEN=
VBEE_STT_APP_ID=
# Để trống để dùng VBEE_API_BASE_URL; chỉ đặt khi endpoint cũ dùng host riêng.
VBEE_STT_API_BASE_URL=
VBEE_TRANSCRIBE_PATH=/v1/audio/transcriptions
VBEE_HEALTH_PATH=/api/v1/models?category=speech-to-text
VBEE_RESULT_PATH_TEMPLATE=/v1/transcribe/{id}
VBEE_FILE_FIELD=file
VBEE_MODE_FIELD=mode
VBEE_MODEL=chunkformer
VBEE_MODEL_FIELD=model
VBEE_RESPONSE_FORMAT=json
VBEE_RESPONSE_FORMAT_FIELD=response_format
VBEE_LANGUAGE=vi
VBEE_LANGUAGE_FIELD=language
VBEE_FILENAME_FIELD=
VBEE_SPEAKER_LABELS_FIELD=
VBEE_KEYWORDS_FIELD=keywords
VBEE_ID_PATH=
VBEE_STATUS_PATH=
VBEE_TEXT_PATH=
VBEE_WORDS_PATH=
VBEE_DURATION_PATH=
VBEE_STT_POLL_INTERVAL_MS=3000
VBEE_STT_TIMEOUT_MS=1800000
VBEE_STT_MAX_WAV_MB=99
VBEE_STT_CHUNK_SECONDS=6
VBEE_STT_AUDIO_CONVERT_TIMEOUT_MS=600000
VBEE_STT_AUDIO_FILTER=anull
# Không bắt buộc vì backend đã polling trạng thái.
VBEE_STT_WEBHOOK_URL=

# Sonix.ai API - lấy tại https://my.sonix.ai/api
# Sonix dùng Bearer API key, upload /v1/media, poll status rồi lấy transcript.json.
SONIX_API_KEY=your_sonix_api_key_here
SONIX_API_BASE_URL=https://api.sonix.ai/v1
SONIX_LANGUAGE=vi
SONIX_FOLDER_ID=
SONIX_KEYWORDS=
SONIX_POLL_INTERVAL_MS=5000
SONIX_TIMEOUT_MS=1800000
SONIX_CALLBACK_URL=
SONIX_CALLBACK_SECRET=
MEDIA_PROBE_TIMEOUT_MS=120000
PROVIDER_REQUEST_TIMEOUT_MS=1800000

# Deepgram API - dùng khi TRANSCRIPTION_PROVIDER=deepgram
# Deepgram nhận file trực tiếp qua POST https://api.deepgram.com/v1/listen
DEEPGRAM_API_KEY=your_deepgram_api_key_here
DEEPGRAM_API_BASE_URL=https://api.deepgram.com/v1
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=vi
DEEPGRAM_DETECT_LANGUAGE=false
DEEPGRAM_SMART_FORMAT=true
DEEPGRAM_PUNCTUATE=true
DEEPGRAM_PARAGRAPHS=true
DEEPGRAM_UTTERANCES=true
DEEPGRAM_KEYWORDS=
DEEPGRAM_DIARIZE_MODEL=

# Dịch transcript sang ngôn ngữ khác
# auto thử lần lượt MyMemory -> AssemblyAI -> Google Cloud Translation.
# Chỉ báo lỗi sau khi tất cả provider đã cấu hình đều thất bại.
TRANSLATION_PROVIDER=auto
TRANSLATION_PROVIDER_CHAIN=mymemory,assemblyai,google-cloud-translation
ASSEMBLYAI_UNDERSTANDING_URL=https://llm-gateway.assemblyai.com/v1/understanding
GOOGLE_TRANSLATE_API_URL=https://translation.googleapis.com/language/translate/v2
GOOGLE_TRANSLATE_API_KEY=
TRANSLATION_REQUEST_TIMEOUT_MS=30000
MAX_TRANSLATION_CHARS=200000

# Fallback: LibreTranslate compatible API hoặc MyMemory public API
LIBRETRANSLATE_API_URL=https://libretranslate.com
LIBRETRANSLATE_API_KEY=
MYMEMORY_API_URL=https://api.mymemory.translated.net
MYMEMORY_EMAIL=

# AssemblyAI - dùng khi TRANSCRIPTION_PROVIDER=assemblyai
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_TRANSLATION_ENABLED=true
ASSEMBLYAI_SPEECH_MODELS=universal-3-5-pro,universal-2
